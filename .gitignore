# Python and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
build/
dist/
*.egg-info/
.ipynb_checkpoints/

# Operating-system and editor files
.DS_Store
.idea/
.vscode/

# Dataset-builder scratch space; checked-in reference archives remain tracked.
datasets/**/candidates/
datasets/**/scratch/
datasets/**/work/
datasets/**/tmp/
datasets/**/__pycache__/

# Local application calculations are deliberately excluded from version control.
applications/runs/**
applications/results/**
applications/plots/**
applications/logs/**
applications/scratch/**
applications/**/.cache/
applications/**/*.npz
applications/**/*.json
applications/**/*.csv
applications/**/*.out
applications/**/*.err
applications/**/*.log
!applications/**/.gitkeep
